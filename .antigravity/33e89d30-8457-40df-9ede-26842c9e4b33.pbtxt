        }
        lines {
          text: "    return `/**"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * @file rendering_engine.h"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " * @brief High-speed FastLED rendering pipeline with double buffer mappings."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: " */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#ifndef RENDERING_ENGINE_H"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#define RENDERING_ENGINE_H"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#include <Arduino.h>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#include <FastLED.h>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "#include \"image_data.h\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "class POV_Engine {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "private:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint16_t numLeds;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint8_t pinArm1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint8_t pinArm2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    CRGB* ledsArm1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    CRGB* ledsArm2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint32_t currentUsecPerSector;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint32_t currentRpm;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint8_t globalBrightness;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "public:"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    POV_Engine() : numLeds(45), currentUsecPerSector(400), currentRpm(0), globalBrightness(${config.maxBrightness}) {}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    void begin(uint16_t ledsCount, uint8_t pinA1, uint8_t pinA2) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        numLeds = ledsCount;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        pinArm1 = pinA1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        pinArm2 = pinA2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ledsArm1 = new CRGB[numLeds];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ledsArm2 = new CRGB[numLeds];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Hardware FastLED initialisation utilizing I2S/DMA parallel outputs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        FastLED.addLeds<WS2812B, ${config.pinLedArm1}, GRB>(ledsArm1, numLeds).setCorrection(TypicalLEDStrip);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        FastLED.addLeds<WS2812B, ${config.pinLedArm2}, GRB>(ledsArm2, numLeds).setCorrection(TypicalLEDStrip);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        FastLED.setBrightness(globalBrightness);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        FastLED.clear();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        FastLED.show();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    void updateRotorPeriod(uint32_t periodUs) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Calculate rotational specs"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        currentRpm = 60000000 / periodUs;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Microsecond allocation per sector (e.g., 60 separate angular sectors)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        currentUsecPerSector = periodUs / POV_SLICES;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint32_t getMicrosecondsPerSector() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return currentUsecPerSector;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint32_t getCurrentCalculatedRpm() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return currentRpm;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    void setGlobalBrightness(uint8_t b) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        globalBrightness = b;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        FastLED.setBrightness(b);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint8_t getGlobalBrightness() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return globalBrightness;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    void loadPatternPreset(const char* presetName) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Serial.printf(\"Device loaded dynamic pattern: %s\\\\n\", presetName);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // High performance drawing routine called by Core 1 inside sector interruptions"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    void renderSector(uint16_t sectorIndex) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Arm 1 draws the selected slice direct from FLASH to save Heap memory"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Arm 2 draws the 180-degree offset slice (which is index sectorIndex + (POV_SLICES/2) % POV_SLICES)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        uint16_t sectorArm1 = sectorIndex;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        uint16_t sectorArm2 = (sectorIndex + (POV_SLICES / 2)) % POV_SLICES;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        for (int i = 0; i < numLeds; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Read binary colors from Flash Memory to prevents cache thrashing"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            uint8_t r1 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm1][i][0]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            uint8_t g1 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm1][i][1]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            uint8_t b1 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm1][i][2]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            uint8_t r2 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm2][i][0]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            uint8_t g2 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm2][i][1]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            uint8_t b2 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm2][i][2]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Hardware thermal/current optimization check"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // High current density can cause the contacts of standard PCB slip-rings to weld."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Brightness limiter keeps total sector energy draw low."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            ledsArm1[i] = CRGB(r1, g1, b1);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            ledsArm2[i] = CRGB(r2, g2, b2);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        FastLED.show();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
