        }
        lines {
          text: "                <svg viewBox=\"0 0 340 100\" className=\"w-full h-[115px] bg-[#000]/80 border border-[#2A2D33]/60 relative shrink-0\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <defs>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <linearGradient id=\"glow-grad-rpm\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <stop offset=\"0%\" stopColor=\"#00F0FF\" stopOpacity=\"0.25\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <stop offset=\"100%\" stopColor=\"#00F0FF\" stopOpacity=\"0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    </linearGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <linearGradient id=\"glow-grad-cpu\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <stop offset=\"0%\" stopColor=\"#FF4E00\" stopOpacity=\"0.25\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <stop offset=\"100%\" stopColor=\"#FF4E00\" stopOpacity=\"0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    </linearGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <linearGradient id=\"glow-grad-temp\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <stop offset=\"0%\" stopColor=\"#FFB800\" stopOpacity=\"0.25\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
