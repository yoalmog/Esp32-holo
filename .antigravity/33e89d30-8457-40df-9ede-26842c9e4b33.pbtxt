          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  {isSerialFeasible ? \'FEASIBLE FOR SER PIX\' : \'DMA OVERLAP WARNING\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                </span>"
