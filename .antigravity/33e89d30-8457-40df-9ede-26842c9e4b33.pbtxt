          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <line x1=\"10\" y1=\"50\" x2=\"330\" y2=\"50\" stroke=\"#2A2D33\" strokeDasharray=\"3,3\" strokeWidth=\"0.5\" />"
