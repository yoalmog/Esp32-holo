          text: "    attachInterrupt(digitalPinToInterrupt(${config.pinHallSensor}), handleHallSensorInterrupt, FALLING);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Initializing high torque Wi-Fi in AP/STA coexistence mode"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    WiFi.setHostname(HOSTNAME);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    WiFi.begin(WIFI_SSID, WIFI_PASS);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    uint8_t wifiTimeout = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    while (WiFi.status() != WL_CONNECTED && wifiTimeout < 15) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
