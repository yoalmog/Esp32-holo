        }
        lines {
          text: "                <svg viewBox=\"0 0 340 100\" className=\"w-full h-[115px] bg-[#000]/80 border border-[#2A2D33]/60 relative shrink-0\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
