        }
        lines {
          text: "    // Set up Websockets and standard endpoints"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ws.onEvent(onWsEvent);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    server.addHandler(&ws);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    server.on(\"/api/telemetry\", HTTP_GET, [](AsyncWebServerRequest *request){"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        DynamicJsonDocument doc(128);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        doc[\"rpm\"] = povEngine.getCurrentCalculatedRpm();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        doc[\"brightness\"] = povEngine.getGlobalBrightness();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        doc[\"temperature\"] = temperatureRead();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        doc[\"voltage\"] = 5.02;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        String response;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        serializeJson(doc, response);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        request->send(200, \"application/json\", response);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ElegantOTA.begin(&server); // Inbuilt firmware update portal"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    server.begin();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Spawn high-speed rendering engine on Core 1 (Isolated, full-priority execution)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    xTaskCreatePinnedToCore("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        highSpeedRenderingLoop,    /* Function to implement the task */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \"POV_RenderTask\",          /* Name of the task */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        8192,                      /* Stack size in words */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        NULL,                      /* Task input parameter */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        configMAX_PRIORITIES - 1,  /* High execution priority priority */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        NULL,                      /* Task handle. */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        1                          /* Core ID (Core 1) */"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "void loop() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Core 0 processes standard client TCP requests, web services and elegantOTA"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ElegantOTA.loop();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ws.cleanupClients();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    delay(10);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "`;"
