          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          // Render character outline around the outer band (0.65 to 0.85 radius)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          if (rFract > 0.65 && rFract < 0.85) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
