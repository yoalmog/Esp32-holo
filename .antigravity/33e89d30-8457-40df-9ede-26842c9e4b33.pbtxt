        lines {
          text: "          if (Math.abs(rFract - 0.6) < 0.015 || Math.abs(rFract - 0.9) < 0.015) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            return { r: 0, g: 180, b: 255 }; // Light blue borders"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          return { r: 0, g: 0, b: 0 };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Default: Concentric procedural energy core"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (Math.sin(radiusFract * 15 - timestamp / 150) > 0.75) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          return { r: 0, g: 255, b: 180 };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        return { r: 5, g: 5, b: 8 };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // 2. Physics-Based Rotational Mechanics & Sub-Stepping Frame Interpolation"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // At 60FPS in browser, if the simulated RPM is 1200, the arm rotates 120 deg per update frame."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // To prevent showing a static 2-blade propeller and instead show a connected physical POV image,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // we must compute and draw the states in \"sub-steps\" integrated over that 120-degree sweep!"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const rpm = config.rpm;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const anglePerSec = (rpm / 60) * Math.PI * 2; // Rad per sec"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const angleThisFrame = isPlaying ? anglePerSec * dt : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Calculate how many sub-steps are needed based on speed to ensure complete spatial fill"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // Max 60 sub-steps per render cycle to avoid locking the UI thread"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      let numSubsteps = 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (isPlaying && rpm > 50) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        numSubsteps = Math.min(32, Math.ceil(Math.abs(angleThisFrame) * 200)); // Dynamic sub-stepping!"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const pulseFreq = timestamp / 300;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const baseJitterRad = ((Math.random() - 0.5) * config.sensorJitterUs / 1000000) * anglePerSec; // Real sensor microsecond jitter"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const numArms = 2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const stripsPerArm = 3;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const ledsPerStrip = 45;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Step through all angular subdivisions of this frame slice"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      for (let step = 0; step < numSubsteps; step++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const stepFactor = numSubsteps > 1 ? step / (numSubsteps - 1) : 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const currentSweptAngle = localAngle + angleThisFrame * stepFactor + baseJitterRad;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Draw 2 Arms (Arm A: currentSweptAngle, Arm B: currentSweptAngle + PI)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        for (let arm = 0; arm < config.numArms; arm++) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          const armAngle = currentSweptAngle + (arm * Math.PI * 2 / config.numArms);"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "        for (let arm = 0; arm < numArms; arm++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const armAngle = currentSweptAngle + (arm * Math.PI * 2 / numArms);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          // Draw 3 Parallel LED Strips per arm: Left, Center, Right"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          // Placed adjacent to simulate commercial dense rendering and antialiasing"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          for (let strip = 0; strip < config.stripsPerArm; strip++) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "          for (let strip = 0; strip < stripsPerArm; strip++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // High-end stagger: Center strip is straight, Left/Right are offset by a tiny radial stagger (1.8 degrees)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            const stripStaggerRad = (strip - (config.stripsPerArm - 1) / 2) * 0.024;"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            const stripStaggerRad = (strip - (stripsPerArm - 1) / 2) * 0.024;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            const absoluteStripAngle = armAngle + stripStaggerRad;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Draw 45 LEDs per strip (Outwards from central axis of spin)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Starts at radius 8px buffer, extends to maxRadius"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            for (let i = 0; i < config.ledsPerStrip; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "              const ledRadiusFract = (i + 1) / config.ledsPerStrip; // 0.02 to 1.0"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "            for (let i = 0; i < ledsPerStrip; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              const ledRadiusFract = (i + 1) / ledsPerStrip; // 0.02 to 1.0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              const ledRadius = 8 + ledRadiusFract * maxRadius;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Calculate (x,y) coordinates in Cartesian space"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const ledX = centerX + Math.cos(absoluteStripAngle) * ledRadius;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const ledY = centerY + Math.sin(absoluteStripAngle) * ledRadius;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Normalized Cartesian coordinate for pattern sampling (-1 to +1 relative to radius)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const normX = Math.cos(absoluteStripAngle) * ledRadiusFract;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const normY = Math.sin(absoluteStripAngle) * ledRadiusFract;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Sample the pattern at this space"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const rgb = samplePattern(normX, normY, absoluteStripAngle, ledRadiusFract);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Apply device brightness multiplier"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const brightnessMul = config.brightness / 255;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const r = Math.floor(rgb.r * brightnessMul);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const g = Math.floor(rgb.g * brightnessMul);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const b = Math.floor(rgb.b * brightnessMul);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Skip rendering black LEDs entirely to optimize drawing performance"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              if (r < 5 && g < 5 && b < 5) continue;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Compute glow properties for physical visual rendering"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // In rotating systems, outer LEDs travel significantly faster and appear slightly blurred"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const physicalVelocityFactor = ledRadiusFract * (rpm / 1200);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const size = isPlaying && rpm > 100 "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ? 1.5 + physicalVelocityFactor * 1.5 // Outer LEDs draw wider radial arcs (smears slightly)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                : 2.5; // Large crisp dots when stopped"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Draw physical LED pixel"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              ctx.beginPath();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              ctx.arc(ledX, ledY, size, 0, Math.PI * 2);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const pulseCoeff = Math.abs(Math.sin(pulseFreq + i * 0.1));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const intensityGlow = config.showLeds ? 1.0 : (0.55 + pulseCoeff * 0.15);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${intensityGlow})`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              ctx.fill();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Add subtle specular highlights on top of LEDs for highly realistic high-density feel"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              if (config.showLeds) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.fillRect(ledX - 0.5, ledY - 0.5, 1, 1);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // 3. Optional Overlay: Draw physical PCB lines (Arms) when stopped or running slow"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (config.showLeds && (rpm < 300 || !isPlaying)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ctx.save();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ctx.translate(centerX, centerY);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ctx.rotate(localAngle);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ctx.strokeStyle = \'rgba(16, 185, 129, 0.12)\'; // Ghost green outline of physical PCB substrate"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ctx.lineWidth = 14;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ctx.beginPath();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ctx.moveTo(-maxRadius - 5, 0);"
