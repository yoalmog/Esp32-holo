        lines {
          text: "                {isSerialFeasible ? ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  \"The microcontroller writing serial protocol pixels can finish writing state transitions prior to entering the next angular sector. Frame tearing is avoided.\""
