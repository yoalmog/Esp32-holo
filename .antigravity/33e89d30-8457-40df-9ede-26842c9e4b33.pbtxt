          text: "        uint8_t pin = (stripId == 1) ? pinArm1 : pinArm2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // In physical deploy, signal noise on active lines is verified via FastLED error buffers or pin output telemetry check"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (globalBrightness > 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            #if defined(ESP32)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // Reads hardware register level of the pin, if it is clamped low when sending high-intensity data streams, a line break/short is registered"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            if (gpio_get_level((gpio_num_t)pin) == 0) {"
