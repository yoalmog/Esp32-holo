          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <strong className=\"text-slate-300\">Asymmetric Load balancing:</strong> If you place a heavier component (e.g., the ESP32 chip or buck converter) on Arm 1, you MUST secure a matching dummy counterweight (zinc solder clips or adhesive lead foils) at the exact radial distance on Arm 2."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
