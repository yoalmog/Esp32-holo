        }
        lines {
          text: "      purpose: \'Converts unregulated 12V slip-ring voltage down to robust, Ripple-Free 5V logic power.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      kicadDesignator: \'U3\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      criticalMetric: \'Synchronous Rectification (>94% efficiency)\'"
