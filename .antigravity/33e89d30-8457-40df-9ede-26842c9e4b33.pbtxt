    instruction: "Theme FirmwareGenerator component layout, tab selectors, form boxes, inputs, status indicators and codes area to the Specialist theme"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col h-full justify-between\" id=\"firmware-compilation-generator\">\n      {/* Configuration Header */}\n      <div className=\"flex items-center justify-between pb-4 border-b border-slate-800 mb-6\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"p-2 bg-emerald-500/10 text-emerald-400 rounded-lg\">\n            <Cpu className=\"w-5 h-5\" id=\"firmware-chip-ico\" />\n          </div>\n          <div>\n            <h3 className=\"font-sans font-semibold text-slate-100 tracking-tight text-md\">Embedded Firmware Compiler</h3>\n            <p className=\"font-mono text-slate-500 text-xs\">Asynchronous Direct GPIO DMA Output</p>\n          </div>\n        </div>\n        <div className=\"flex gap-2\">\n          {/* Quick Config Modal Trigger or direct inputs */}\n          <div className=\"flex bg-slate-800 rounded-lg p-0.5 border border-slate-700/60\">\n            <button\n              onClick={() => setActiveTab(\'main\')}\n              className={`font-mono text-[10px] px-2.5 py-1 rounded-md transition ${activeTab === \'main\' ? \'bg-indigo-500 text-white shadow-sm\' : \'text-slate-400 hover:text-slate-200\'}`}\n            >\n              main.cpp\n            </button>\n            <button\n              onClick={() => setActiveTab(\'engine\')}\n              className={`font-mono text-[10px] px-2.5 py-1 rounded-md transition ${activeTab === \'engine\' ? \'bg-indigo-500 text-white shadow-sm\' : \'text-slate-400 hover:text-slate-200\'}`}\n            >\n              engine.h\n            </button>\n            <button\n              onClick={() => setActiveTab(\'data\')}\n              className={`font-mono text-[10px] px-2.5 py-1 rounded-md transition ${activeTab === \'data\' ? \'bg-indigo-500 text-white shadow-sm\' : \'text-slate-400 hover:text-slate-200\'}`}\n            >\n              image_data.h\n            </button>\n            <button\n              onClick={() => setActiveTab(\'platformio\')}\n              className={`font-mono text-[10px] px-2.5 py-1 rounded-md transition ${activeTab === \'platformio\' ? \'bg-indigo-500 text-white shadow-sm\' : \'text-slate-400 hover:text-slate-200\'}`}\n            >\n              platformio.ini\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Mini Parameter Customizer Block */}\n      <div className=\"bg-slate-950/60 p-4 rounded-xl border border-slate-800/80 mb-5 text-slate-200\">\n        <h4 className=\"font-sans font-medium text-xs text-slate-300 flex items-center gap-1.5 mb-3\">\n          <Settings className=\"w-3.5 h-3.5 text-indigo-400\" />\n          Hardware Compile parameters\n        </h4>\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n          <div>\n            <label className=\"block text-[10px] text-slate-500 font-mono uppercase mb-1\">Wi-Fi SSID</label>\n            <input\n              type=\"text\"\n              value={config.ssid}\n              onChange={(e) => onChangeConfig({ ssid: e.target.value })}\n              className=\"w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-xs text-slate-200 font-mono focus:border-indigo-500 focus:outline-none\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[10px] text-slate-500 font-mono uppercase mb-1\">Wi-Fi Password</label>\n            <input\n              type=\"password\"\n              value={config.wifiPass}\n              onChange={(e) => onChangeConfig({ wifiPass: e.target.value })}\n              className=\"w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-xs text-slate-200 font-mono focus:border-indigo-500 focus:outline-none\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[10px] text-slate-500 font-mono uppercase mb-1\">MCU Device Node</label>\n            <input\n              type=\"text\"\n              value={config.hostname}\n              onChange={(e) => onChangeConfig({ hostname: e.target.value })}\n              className=\"w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-xs text-slate-300 font-mono focus:border-indigo-500 focus:outline-none\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[10px] text-slate-500 font-mono uppercase mb-1\">GPIO Hall sensor</label>\n            <input\n              type=\"number\"\n              value={config.pinHallSensor}\n              onChange={(e) => onChangeConfig({ pinHallSensor: parseInt(e.target.value) || 0 })}\n              className=\"w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-xs text-slate-300 font-mono focus:border-indigo-500 focus:outline-none\"\n            />\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4 mt-4 pt-4 border-t border-slate-900\">\n          <div>\n            <label className=\"block text-[10px] text-slate-500 font-mono uppercase mb-1\">Led Arm 1 GPIO</label>\n            <input\n              type=\"number\"\n              value={config.pinLedArm1}\n              onChange={(e) => onChangeConfig({ pinLedArm1: parseInt(e.target.value) || 0 })}\n              className=\"w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-xs text-slate-300 font-mono\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[10px] text-slate-500 font-mono uppercase mb-1\">Led Arm 2 GPIO</label>\n            <input\n              type=\"number\"\n              value={config.pinLedArm2}\n              onChange={(e) => onChangeConfig({ pinLedArm2: parseInt(e.target.value) || 0 })}\n              className=\"w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-xs text-slate-300 font-mono\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[10px] text-slate-500 font-mono uppercase mb-1\">Dma Strip count</label>\n            <div className=\"font-mono text-xs text-indigo-400 mt-1.5 font-semibold\">\n              {config.numArms * config.stripsPerArm} Outputs (270 LEDs)\n            </div>\n          </div>\n          <div>\n            <label className=\"block text-[10px] text-slate-500 font-mono uppercase mb-1\">Dma Parallel driving</label>\n            <div className=\"font-mono text-xs text-emerald-400 mt-1.5 font-semibold\">\n              I2S CHN {config.dmaChannel} DMA ACTIVE\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Code Viewer Workspace */}\n      <div className=\"relative bg-slate-950 border border-slate-800/80 rounded-xl overflow-hidden flex-1 flex flex-col justify-between\">\n        <div className=\"flex justify-between items-center bg-slate-900 px-4 py-2 border-b border-slate-800/60\">\n          <span className=\"font-mono text-xs text-indigo-300 flex items-center gap-1.5\">\n            <FileCode className=\"w-3.5 h-3.5\" />\n            {activeTab === \'main\' ? \'main.cpp\' : activeTab === \'engine\' ? \'rendering_engine.h\' : activeTab === \'data\' ? \'image_data.h\' : \'platformio.ini\'}\n          </span>\n          <button\n            onClick={() => triggerCopy(activeTab, codeContents[activeTab])}\n            className=\"font-mono text-[10pt] text-slate-400 hover:text-white transition flex items-center gap-1 bg-slate-800 px-2.5 py-1 rounded\"\n          >\n            {copied === activeTab ? <Check className=\"w-3 h-3 text-emerald-400\" /> : <Copy className=\"w-3 h-3\" />}\n            {copied === activeTab ? \'Copied\' : \'Copy Code\'}\n          </button>\n        </div>\n\n        {/* Real Source Code Area */}\n        <pre className=\"p-4 overflow-y-auto max-h-[340px] text-slate-300 font-mono text-[11px] leading-relaxed text-left flex-1 bg-slate-950\">\n          <code>{codeContents[activeTab]}</code>\n        </pre>\n\n        {/* Footer Warning Board */}\n        <div className=\"bg-slate-900/60 p-3.5 border-t border-slate-800/70 flex gap-3 text-xs text-slate-400 items-start\">\n          <ShieldCheck className=\"w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" />\n          <div>\n            <p className=\"font-sans font-medium text-slate-300\">Isolated Multithreading Protection</p>\n            <p className=\"text-slate-500 text-[11px] mt-0.5 leading-normal\">\n              Running FastLED on Core 1 ensures zero interrupt jitter caused by task swapping. Core 0 can load files from LittleFS or handle Wi-Fi safely while spinning.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>"
        replacement_content: "  return (\n    <div className=\"bg-[#0E1012] border border-[#2A2D33] rounded-sm p-6 flex flex-col h-full justify-between animate-fade-in\" id=\"firmware-compilation-generator\">\n      {/* Configuration Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center justify-between pb-4 border-b border-[#2A2D33] mb-6 gap-4\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-2.5 h-6 bg-[#00F0FF] rounded-none\"></div>\n          <div>\n            <h3 className=\"font-mono text-xs uppercase tracking-widest text-[#E0E2E5] font-semibold\">03 // FIRMWARE COMPILER</h3>\n            <p className=\"font-mono text-[#8E9299] text-[10px] uppercase\">DMA Pinned core 1 task generators // fastLed wrappers</p>\n          </div>\n        </div>\n        \n        {/* Tab switch mechanism */}\n        <div className=\"flex bg-[#15171A] p-1 border border-[#2A2D33] self-start md:self-auto overflow-x-auto max-w-full\">\n          {([\'main\', \'engine\', \'data\', \'platformio\'] as const).map((tab) => (\n            <button\n              key={tab}\n              onClick={() => setActiveTab(tab)}\n              className={`font-mono text-[10px] uppercase tracking-wider px-3 py-1.5 transition cursor-pointer whitespace-nowrap ${\n                activeTab === tab\n                  ? \'bg-[#00F0FF] text-[#000] font-bold\'\n                  : \'text-[#8E9299] hover:text-[#E0E2E5]\'\n              }`}\n            >\n              {tab === \'main\' ? \'main.cpp\' : tab === \'engine\' ? \'engine.h\' : tab === \'data\' ? \'data.h\' : \'platformio.ini\'}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Mini Parameter Customizer Block */}\n      <div className=\"bg-[#15171A] p-4 rounded-none border-l-2 border-[#00F0FF] border-y border-r border-[#2A2D33] mb-5 text-[#E0E2E5]\">\n        <h4 className=\"font-mono text-xs uppercase tracking-wider text-[#00F0FF] flex items-center gap-2 mb-4\">\n          <Sliders className=\"w-4 h-4\" />\n          Hardware Compile parameters & PINOUTS\n        </h4>\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n          <div>\n            <label className=\"block text-[9px] text-[#8E9299] font-mono uppercase mb-1\">Wi-Fi SSID</label>\n            <input\n              type=\"text\"\n              value={config.ssid}\n              onChange={(e) => onChangeConfig({ ssid: e.target.value })}\n              className=\"w-full bg-[#0E1012] border border-[#2A2D33] px-2 py-1 text-xs text-[#00F0FF] font-mono focus:border-[#00F0FF] focus:outline-none rounded-none\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[9px] text-[#8E9299] font-mono uppercase mb-1\">Wi-Fi Wireless Key</label>\n            <input\n              type=\"password\"\n              value={config.wifiPass}\n              onChange={(e) => onChangeConfig({ wifiPass: e.target.value })}\n              className=\"w-full bg-[#0E1012] border border-[#2A2D33] px-2 py-1 text-xs text-[#00F0FF] font-mono focus:border-[#00F0FF] focus:outline-none rounded-none\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[9px] text-[#8E9299] font-mono uppercase mb-1\">MCU Device Name</label>\n            <input\n              type=\"text\"\n              value={config.hostname}\n              onChange={(e) => onChangeConfig({ hostname: e.target.value })}\n              className=\"w-full bg-[#0E1012] border border-[#2A2D33] px-2 py-1 text-xs text-[#30f4ff] font-mono focus:border-[#00F0FF] focus:outline-none rounded-none\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[9px] text-[#8E9299] font-mono uppercase mb-1\">GPIO Hall sensor</label>\n            <input\n              type=\"number\"\n              value={config.pinHallSensor}\n              onChange={(e) => onChangeConfig({ pinHallSensor: parseInt(e.target.value) || 0 })}\n              className=\"w-full bg-[#0E1012] border border-[#2A2D33] px-2 py-1 text-xs text-[#30f4ff] font-mono focus:border-[#00F0FF] focus:outline-none rounded-none\"\n            />\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4 mt-4 pt-4 border-t border-[#2A2D33]\">\n          <div>\n            <label className=\"block text-[9px] text-[#8E9299] font-mono uppercase mb-1\">Led Arm 1 GPIO</label>\n            <input\n              type=\"number\"\n              value={config.pinLedArm1}\n              onChange={(e) => onChangeConfig({ pinLedArm1: parseInt(e.target.value) || 0 })}\n              className=\"w-full bg-[#0E1012] border border-[#2A2D33] px-2 py-1 text-xs text-[#30f4ff] font-mono focus:border-[#00F0FF] focus:outline-none rounded-none\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[9px] text-[#8E9299] font-mono uppercase mb-1\">Led Arm 2 GPIO</label>\n            <input\n              type=\"number\"\n              value={config.pinLedArm2}\n              onChange={(e) => onChangeConfig({ pinLedArm2: parseInt(e.target.value) || 0 })}\n              className=\"w-full bg-[#0E1012] border border-[#2A2D33] px-2 py-1 text-xs text-[#30f4ff] font-mono focus:border-[#00F0FF] focus:outline-none rounded-none\"\n            />\n          </div>\n          <div>\n            <label className=\"block text-[9px] text-[#8E9299] font-mono uppercase mb-1\">DMA STRIP SPECS</label>\n            <div className=\"font-mono text-xs text-[#00F0FF] mt-1.5 font-bold uppercase\">\n              {config.numArms * config.stripsPerArm} Strips // 270 LEDs\n            </div>\n          </div>\n          <div>\n            <label className=\"block text-[9px] text-[#8E9299] font-mono uppercase mb-1\">FreeRTOS Priority</label>\n            <div className=\"font-mono text-xs text-[#FFB800] mt-1.5 font-bold uppercase\">\n              Task core 1 // PRIO: 24 active\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Code Viewer Workspace */}\n      <div className=\"relative bg-[#000] border border-[#2A2D33] rounded-none overflow-hidden flex-1 flex flex-col justify-between\">\n        <div className=\"flex justify-between items-center bg-[#15171A] px-4 py-2 border-b border-[#2A2D33]\">\n          <span className=\"font-mono text-xs text-[#00F0FF] flex items-center gap-1.5 uppercase font-bold tracking-wider\">\n            <FileCode className=\"w-4 h-4\" />\n            {activeTab === \'main\' ? \'main.cpp\' : activeTab === \'engine\' ? \'rendering_engine.h\' : activeTab === \'data\' ? \'image_data.h\' : \'platformio.ini\'}\n          </span>\n          <button\n            onClick={() => triggerCopy(activeTab, codeContents[activeTab])}\n            className=\"font-mono text-[9px] uppercase tracking-wider text-[#00F0FF] hover:brightness-110 transition flex items-center gap-1 bg-[#0E1012] border border-[#2A2D33] px-2.5 py-1.5 rounded-none cursor-pointer select-none\"\n          >\n            {copied === activeTab ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n            {copied === activeTab ? \'COPIED\' : \'COPY BUFFER\'}\n          </button>\n        </div>\n\n        {/* Real Source Code Area */}\n        <pre className=\"p-4 overflow-y-auto max-h-[340px] text-[#E0E2E5] font-mono text-[11px] leading-relaxed text-left flex-1 bg-[#000]\">\n          <code>{codeContents[activeTab]}</code>\n        </pre>\n\n        {/* Footer Warning Board */}\n        <div className=\"bg-[#15171A] p-3.5 border-t border-[#2A2D33] flex gap-3 text-xs text-[#8E9299] items-start uppercase\">\n          <ShieldCheck className=\"w-4 h-4 text-[#00F0FF] shrink-0 mt-0.5 shadow-[0_0_8px_#00F0FF]\" />\n          <div>\n            <p className=\"font-mono font-bold text-[#E0E2E5] tracking-wider text-[11px]\">FreeRTOS Core-Priority Isolation Masked</p>\n            <p className=\"text-[#8E9299] text-[10px] mt-0.5 leading-normal\">\n              SPINNING FASTLED ON CORE 1 PREVENTS JITTER AND FLICKER CAUSED BY OTHER BACKGROUND CONCURRENT TASKS. CORE 0 HANDLES WEB INTERRUPTS AND CAPTIVE PORTALS SAFELY.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
