        }
        lines {
          text: "                }`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  {sensorFault ? \'CRITICAL_FAULT\' : currentRpm === 0 ? \'STANDBY_HALTED\' : \'SYS_LOCKED_RPM\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
