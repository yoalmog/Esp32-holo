      fuzzy_match: "\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col h-full justify-between\" id=\"dashboard-controller-portal\">\n      {/* Heading */}\n      <div className=\"flex items-center justify-between pb-4 border-b border-slate-800 mb-6\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"p-2 bg-indigo-500/10 text-indigo-400 rounded-lg\">\n            <Wifi className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h3 className=\"font-sans font-semibold text-slate-100 tracking-tight text-md\">ESP32 Captive portal Control</h3>\n            <p className=\"font-mono text-slate-500 text-xs\">Real-Time WebSocket Link: Connected</p>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-2 bg-indigo-500/10 px-3 py-1.5 rounded-lg border border-indigo-500/20\">\n          <span className=\"w-1.5 h-1.5 rounded-full bg-indigo-400 animate-ping\"></span>\n          <span className=\"font-mono text-xs text-indigo-300 font-semibold uppercase\">Captive Portal Active</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        \n        {/* Left Control Panel Column */}\n        <div className=\"lg:col-span-7 space-y-6\">\n          {/* Active Preset Options Grid */}\n          <div>\n            <span className=\"font-mono text-[10px] text-slate-500 uppercase block mb-3 font-semibold\">Select Display Grid / Preset pattern</span>\n            <div className=\"grid grid-cols-2 md:grid-cols-3 gap-2 text-xs\">\n              {[\n                { id: \'test-card\', label: \'Color Bar Grid\', desc: \'Alignment Calibration\' },\n                { id: \'clock\', label: \'Analog Tech Clock\', desc: \'Ticking Vector hands\' },\n                { id: \'spiral\', label: \'Logarithmic Vortex\', desc: \'Double Arm spiral\' },\n                { id: \'nuclear\', label: \'Biohazard WARNING\', desc: \'Industrial Sign\' },\n                { id: \'globe\', label: \'Hologram Globe\', desc: \'Spins Continents\' },\n                { id: \'custom-text\', label: \'Text Ring Banner\', desc: \'Outer marquee text\' },\n              ].map((pat) => (\n                <button\n                  key={pat.id}\n                  id={`preset-select-btn-${pat.id}`}\n                  onClick={() => handlePatternChange(pat.id)}\n                  className={`p-3.5 rounded-xl border text-left transition flex flex-col justify-between ${\n                    simulationConfig.currentPattern === pat.id\n                      ? \'bg-indigo-500/15 border-indigo-500/40 text-indigo-300 shadow-sm\'\n                      : \'bg-slate-950 border-slate-850 hover:bg-slate-850 hover:border-slate-700 text-slate-300\'\n                  }`}\n                >\n                  <span className=\"font-sans font-semibold block\">{pat.label}</span>\n                  <span className=\"text-[9px] text-slate-500 font-mono mt-1 block leading-normal\">{pat.desc}</span>\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Scrolling text banner input */}\n          {simulationConfig.currentPattern === \'custom-text\' && (\n            <div className=\"bg-slate-950 p-4 border border-slate-800 rounded-xl space-y-2\">\n              <label className=\"block text-[10px] text-indigo-400 font-mono uppercase\">Holographic Custom Marquee Text</label>\n              <input\n                id=\"marquee-text-input\"\n                type=\"text\"\n                maxLength={20}\n                value={simulationConfig.customText}\n                onChange={(e) => onChangeSimConfig({ customText: e.target.value })}\n                className=\"w-full bg-slate-900 border border-slate-800 rounded px-3 py-2 text-xs font-mono text-indigo-300 focus:border-indigo-500 focus:outline-none\"\n                placeholder=\"TYPE HOLOGRAM CHARACTERS...\"\n              />\n              <span className=\"block text-[9px] text-slate-500 font-mono\">The character matrix downsamples to a radial segment font library pre-embedded in the rendering controller.</span>\n            </div>\n          )}\n\n          {/* Rotary alignment Calibration offset & motor logic */}\n          <div className=\"bg-slate-950 p-4 border border-slate-800 rounded-xl grid grid-cols-1 md:grid-cols-2 gap-4\">\n            \n            {/* Calibration Offset Slider */}\n            <div>\n              <div className=\"flex justify-between font-mono text-[10px] uppercase mb-1\">\n                <span className=\"text-slate-400\">Sensor Alignment Phase</span>\n                <span className=\"text-indigo-400 font-bold\">{phaseOffset}\302\260 DEG</span>\n              </div>\n              <input\n                type=\"range\"\n                min={-180}\n                max={180}\n                step={5}\n                value={phaseOffset}\n                onChange={(e) => setPhaseOffset(parseInt(e.target.value))}\n                className=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-indigo-500\"\n              />\n              <span className=\"block text-[9px] text-slate-500 font-sans mt-2.5\">\n                Calibrates physical magnetic hall sensor placement. Compensates mechanical angle delay relative to first LED.\n              </span>\n            </div>\n\n            {/* Jitter offset modeling */}\n            <div>\n              <div className=\"flex justify-between font-mono text-[10px] uppercase mb-1\">\n                <span className=\"text-slate-400\">Interrupt Jitter Tol</span>\n                <span className=\"text-amber-400 font-bold\">{simulationConfig.sensorJitterUs} &mu;s</span>\n              </div>\n              <input\n                type=\"range\"\n                min={0}\n                max={450}\n                step={25}\n                value={simulationConfig.sensorJitterUs}\n                onChange={(e) => onChangeSimConfig({ sensorJitterUs: parseInt(e.target.value) })}\n                className=\"w-full h-1 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-amber-500\"\n              />\n              <span className=\"block text-[9px] text-slate-500 font-sans mt-2.5\">\n                Simulates real-world rotor imbalance and physical interrupt latency variance on the GPIO pin.\n              </span>\n            </div>\n\n          </div>\n\n          {/* Motor Toggle */}\n          <div className=\"bg-slate-950 p-4 border border-slate-850 rounded-xl flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <span className=\"p-2 bg-emerald-500/10 text-emerald-400 rounded-lg\">\n                <Sliders className=\"w-4 h-4\" />\n              </span>\n              <div>\n                <span className=\"text-xs font-semibold text-slate-300 block\">Hardware Coil Power Governer</span>\n                <span className=\"text-[9px] text-slate-500 font-mono block\">Shuts off active brushless stator phases</span>\n              </div>\n            </div>\n            \n            <button\n              id=\"motor-gov-toggle-btn\"\n              onClick={toggleMotor}\n              className=\"focus:outline-none transition\"\n            >\n              {motorActive ? (\n                <ToggleRight className=\"w-10 h-10 text-emerald-400\" />\n              ) : (\n                <ToggleLeft className=\"w-10 h-10 text-slate-600\" />\n              )}\n            </button>\n          </div>\n\n        </div>\n\n        {/* Right Telemetry Column */}\n        <div className=\"lg:col-span-5 space-y-4\">\n          <span className=\"font-mono text-[10px] text-slate-500 uppercase block font-semibold\">Active Operational Telemetry</span>\n\n          {/* Big diagnostic metrics board */}\n          <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-3 font-mono text-xs\">\n            <div className=\"flex justify-between items-center py-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 uppercase\">Device status:</span>\n              <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${\n                simulationConfig.rpm === 0 \n                  ? \'bg-amber-500/10 text-amber-500 border border-amber-500/10\'\n                  : \'bg-emerald-500/10 text-emerald-400 border border-emerald-500/10\'\n              }`}>\n                {simulationConfig.rpm === 0 ? \'STANDBY_HALTED\' : \'SYS_LOCKED_RPM\'}\n              </span>\n            </div>\n\n            <div className=\"flex justify-between items-center py-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 uppercase\">Microsecond Jitter:</span>\n              <span className=\"text-slate-300\">\n                &plusmn;{(simulationConfig.sensorJitterUs * 0.45).toFixed(1)} &mu;s\n              </span>\n            </div>\n\n            <div className=\"flex justify-between items-center py-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 uppercase\">Core 0 load (Wi-Fi):</span>\n              <span className=\"text-slate-300\">7.5%</span>\n            </div>\n\n            <div className=\"flex justify-between items-center py-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 uppercase\">Core 1 load (POV DMA):</span>\n              <span className=\"text-slate-300\">\n                {simulationConfig.rpm === 0 ? \'0.2%\' : \'84.2% (Dedicated Interrupt)\'}\n              </span>\n            </div>\n\n            <div className=\"flex justify-between items-center py-1.5 border-b border-slate-900\">\n              <span className=\"text-slate-500 uppercase\">Rotor Temp (Stator coils):</span>\n              <span className=\"text-slate-300\">\n                {simulationConfig.rpm === 0 ? \'28.1\302\260C\' : `${(38.4 + (simulationConfig.rpm / 200)).toFixed(1)}\302\260C`}\n              </span>\n            </div>\n\n            <div className=\"flex justify-between items-center py-1.5\">\n              <span className=\"text-slate-500 uppercase\">Signal RSSI (Wi-Fi):</span>\n              <span className=\"text-emerald-400 font-bold\">-54 dBm (Excellent)</span>\n            </div>\n          </div>\n\n          {/* Terminal Console log output */}\n          <div className=\"bg-slate-950 border border-slate-800/80 rounded-xl overflow-hidden flex flex-col justify-between\">\n            <div className=\"bg-slate-900/80 px-3 py-1.5 border-b border-slate-800 flex justify-between items-center\">\n              <span className=\"font-mono text-[9px] text-slate-500 uppercase flex items-center gap-1\">\n                <Terminal className=\"w-3 h-3 text-indigo-400\" />\n                Live WebSocket Stdio stream\n              </span>\n              <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></span>\n            </div>\n            \n            <div className=\"p-3 font-mono text-[10px] text-slate-400 h-[105px] overflow-y-auto space-y-1.5 text-left bg-slate-950\">\n              {logs.map((log, index) => {\n                let colorClass = \'text-slate-400\';\n                if (log.includes(\'[SYS]\')) colorClass = \'text-blue-400\';\n                if (log.includes(\'[POV]\')) colorClass = \'text-emerald-400\';\n                if (log.includes(\'[NET]\')) colorClass = \'text-indigo-400\';\n                if (log.includes(\'[SEN]\')) colorClass = \'text-amber-400\';\n\n                return (\n                  <p key={index} className={`${colorClass} leading-tight`}>\n                    {log}\n                  </p>\n                );\n              })}\n            </div>\n          </div>\n          \n        </div>\n\n      </div>\n\n    </div>\n"
