        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // 2. Physics-Based Rotational Mechanics & Sub-Stepping Frame Interpolation"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // At 60FPS in browser, if the simulated RPM is 1200, the arm rotates 120 deg per update frame."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // To prevent showing a static 2-blade propeller and instead show a connected physical POV image,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      // we must compute and draw the states in \"sub-steps\" integrated over that 120-degree sweep!"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const rpm = config.rpm;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const anglePerSec = (rpm / 60) * Math.PI * 2; // Rad per sec"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      const angleThisFrame = isPlaying ? anglePerSec * dt : 0;"
