          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      if (config.showLeds && (rpm < 300 || !isPlaying)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
