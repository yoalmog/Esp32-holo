      target_content: "            {/* Linear speed block */}\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between\">\n              <span className=\"font-mono text-[10px] text-slate-500 uppercase\">LED Tip Linear Speed</span>\n              <div className=\"my-2 text-left\">\n                <span className=\"font-sans font-extrabold text-2xl text-slate-100 tracking-tight\">\n                  {velocityKmh.toFixed(1)} <span className=\"text-xs font-normal text-slate-400\">km/h</span>\n                </span>\n                <span className=\"block font-mono text-[10px] text-slate-500 mt-0.5\">\n                  &approx; {velocityMph.toFixed(1)} miles per hour (tip velocity)\n                </span>\n              </div>\n              <div className=\"font-sans text-[10.5px] leading-relaxed text-slate-400 mt-2 bg-slate-900/60 p-2 rounded\">\n                <span className=\"font-semibold block text-slate-300\">Physics Equation:</span>\n                $$v_{\'{tip}\'} = \\omega \\cdot r = \\frac{\'{2\\\\pi \\\\cdot \\\\text{RPM}\'}}{\'{60}\'} \\\\cdot r$$\n              </div>\n            </div>\n\n            {/* Tip Acceleration / G-Force */}\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between\">\n              <span className=\"font-mono text-[10px] text-slate-500 uppercase\">Centrifugal Pull-Apart (G-Force)</span>\n              <div className=\"my-2 text-left\">\n                <span className=\"font-sans font-extrabold text-2xl text-rose-400 tracking-tight\">\n                  {Math.round(gForce).toLocaleString()} <span className=\"text-xs font-normal text-slate-400\">G\'s</span>\n                </span>\n                <span className=\"block font-mono text-[10px] text-rose-500/80 mt-0.5 font-bold\">\n                  LED Pull weight: {forceGramsEquivalent.toFixed(0)} grams ({forceNewtons.toFixed(2)} N)\n                </span>\n              </div>\n              <div className=\"font-sans text-[10.5px] leading-relaxed text-slate-400 mt-2 bg-slate-900/60 p-2 rounded\">\n                <span className=\"font-semibold block text-slate-300\">Physics Equation:</span>\n                $$F_{\'{c}\'} = m \\\\cdot a_{\'{c}\'} = m \\\\cdot \\\\omega^2 \\\\cdot r$$\n              </div>\n            </div>\n\n            {/* Sector Timing constraints */}\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between\">\n              <span className=\"font-mono text-[10px] text-slate-500 uppercase\">Sector Frame Duration</span>\n              <div className=\"my-2 text-left\">\n                <span className=\"font-sans font-extrabold text-2xl text-emerald-400 tracking-tight\">\n                  {sectorDurationUs.toFixed(1)} <span className=\"text-xs font-normal text-slate-400\">&mu;s</span>\n                </span>\n                <span className=\"block font-mono text-[10px] text-slate-500 mt-0.5\">\n                  Period time per rotation: {periodMs.toFixed(1)} ms\n                </span>\n              </div>\n              <div className=\"font-sans text-[10.5px] leading-relaxed text-slate-400 mt-2 bg-slate-900/60 p-2 rounded\">\n                <span className=\"font-semibold block text-slate-300\">Physics Equation:</span>\n                $$T_{\'{sector}\'} = \\frac{\'{T_{\\\\text{rev}}}\'}{\'{N \\\\text{ slices}\'}} = \\frac{\'{60 \\\\cdot 10^6}\'}{\'{\\\\text{RPM} \\\\cdot N}\'}$$\n              </div>\n            </div>"
      replacement_content: "            {/* Linear speed block */}\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between\">\n              <span className=\"font-mono text-[10px] text-slate-500 uppercase\">LED Tip Linear Speed</span>\n              <div className=\"my-2 text-left\">\n                <span className=\"font-sans font-extrabold text-2xl text-slate-100 tracking-tight\">\n                  {velocityKmh.toFixed(1)} <span className=\"text-xs font-normal text-slate-400\">km/h</span>\n                </span>\n                <span className=\"block font-mono text-[10px] text-slate-500 mt-0.5\">\n                  &approx; {velocityMph.toFixed(1)} miles per hour (tip velocity)\n                </span>\n              </div>\n              <div className=\"font-sans text-[10.5px] leading-relaxed text-slate-400 mt-2 bg-slate-900/60 p-2 rounded\">\n                <span className=\"font-semibold block text-slate-300\">Physics Equation:</span>\n                {\"v_tip = \\u03c9 \\u00b7 r = (2\\u03c0 \\u00b7 RPM / 60) \\u00b7 r\"}\n              </div>\n            </div>\n\n            {/* Tip Acceleration / G-Force */}\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between\">\n              <span className=\"font-mono text-[10px] text-slate-500 uppercase\">Centrifugal Pull-Apart (G-Force)</span>\n              <div className=\"my-2 text-left\">\n                <span className=\"font-sans font-extrabold text-2xl text-rose-400 tracking-tight\">\n                  {Math.round(gForce).toLocaleString()} <span className=\"text-xs font-normal text-slate-400\">G\'s</span>\n                </span>\n                <span className=\"block font-mono text-[10px] text-rose-500/80 mt-0.5 font-bold\">\n                  LED Pull weight: {forceGramsEquivalent.toFixed(0)} grams ({forceNewtons.toFixed(2)} N)\n                </span>\n              </div>\n              <div className=\"font-sans text-[10.5px] leading-relaxed text-slate-400 mt-2 bg-slate-900/60 p-2 rounded\">\n                <span className=\"font-semibold block text-slate-300\">Physics Equation:</span>\n                {\"F_c = m \\u00b7 a_c = m \\u00b7 \\u03c9\\u00b2 \\u00b7 r\"}\n              </div>\n            </div>\n\n            {/* Sector Timing constraints */}\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-800 flex flex-col justify-between\">\n              <span className=\"font-mono text-[10px] text-slate-500 uppercase\">Sector Frame Duration</span>\n              <div className=\"my-2 text-left\">\n                <span className=\"font-sans font-extrabold text-2xl text-emerald-400 tracking-tight\">\n                  {sectorDurationUs.toFixed(1)} <span className=\"text-xs font-normal text-slate-400\">&mu;s</span>\n                </span>\n                <span className=\"block font-mono text-[10px] text-slate-500 mt-0.5\">\n                  Period time per rotation: {periodMs.toFixed(1)} ms\n                </span>\n              </div>\n              <div className=\"font-sans text-[10.5px] leading-relaxed text-slate-400 mt-2 bg-slate-900/60 p-2 rounded\">\n                <span className=\"font-semibold block text-slate-300\">Physics Equation:</span>\n                {\"T_sector = T_rev / N_slices = 60,000,000 / (RPM \\u00b7 N_slices)\"}\n              </div>\n            </div>"
