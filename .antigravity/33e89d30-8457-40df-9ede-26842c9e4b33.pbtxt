          text: "            </li>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <li>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <strong className=\"text-slate-300\">Solder Joint Integrity:</strong> Under 1600+ Gs, the gravity mass pulls solder joints outward. Use standard cyanoacrylate structural glue or structural epoxy coatings on all component packages."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            </li>"
