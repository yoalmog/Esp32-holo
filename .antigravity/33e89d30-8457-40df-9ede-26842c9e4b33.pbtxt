      code_search {
        force_disable: false
      }
      internal_search {
        max_results: 10
        max_content_length: 5000
      }
      notify_user {
        artifact_review_mode: ARTIFACT_REVIEW_MODE_ALWAYS
      }
      finish {
      }
      notebook_edit {
        enabled: false
      }
      invoke_subagent {
        enabled: false
