        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Robust Hardware Power Safeguards for high-speed dynamic loads:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Cap dynamic current draw to protect slip-ring brushes and prevent +5V bus breakdown."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        FastLED.setMaxPowerInVoltsAndMilliamps(5, 3000); // Standard 3.0A absolute bus cap"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Verify GPIO pin allocations map cleanly within ESP32 physical boundaries"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (pinArm1 >= 48 || pinArm2 >= 48) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            Serial.println(\"[ERR] [POV] CRITICAL: Invalid GPIO pin allocation in rendering pipeline! Setup aborted.\");"
