        }
        lines {
          text: "    uint16_t numLeds;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    uint8_t pinArm1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
