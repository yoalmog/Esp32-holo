          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const noiseGrid = Math.cos(mapX * 1.5 + rFract * 4) + Math.sin(mapX * 5 - rFract * 8);"
