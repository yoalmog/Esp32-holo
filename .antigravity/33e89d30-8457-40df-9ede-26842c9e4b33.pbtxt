        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            file.close();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
