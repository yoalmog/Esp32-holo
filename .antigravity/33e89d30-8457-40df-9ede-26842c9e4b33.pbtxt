        }
        lines {
          text: "      for (let step = 0; step < numSubsteps; step++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const stepFactor = numSubsteps > 1 ? step / (numSubsteps - 1) : 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        const currentSweptAngle = localAngle + angleThisFrame * stepFactor + baseJitterRad;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Draw 2 Arms (Arm A: currentSweptAngle, Arm B: currentSweptAngle + PI)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        for (let arm = 0; arm < numArms; arm++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const armAngle = currentSweptAngle + (arm * Math.PI * 2 / numArms);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          // Draw 3 Parallel LED Strips per arm: Left, Center, Right"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          // Placed adjacent to simulate commercial dense rendering and antialiasing"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          for (let strip = 0; strip < stripsPerArm; strip++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // High-end stagger: Center strip is straight, Left/Right are offset by a tiny radial stagger (1.8 degrees)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            const stripStaggerRad = (strip - (stripsPerArm - 1) / 2) * 0.024;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            const absoluteStripAngle = armAngle + stripStaggerRad;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Draw 45 LEDs per strip (Outwards from central axis of spin)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Starts at radius 8px buffer, extends to maxRadius"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            for (let i = 0; i < ledsPerStrip; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const ledRadiusFract = (i + 1) / ledsPerStrip; // 0.02 to 1.0"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const ledRadius = 8 + ledRadiusFract * maxRadius;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Calculate (x,y) coordinates in Cartesian space"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const ledX = centerX + Math.cos(absoluteStripAngle) * ledRadius;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const ledY = centerY + Math.sin(absoluteStripAngle) * ledRadius;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Normalized Cartesian coordinate for pattern sampling (-1 to +1 relative to radius)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const normX = Math.cos(absoluteStripAngle) * ledRadiusFract;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const normY = Math.sin(absoluteStripAngle) * ledRadiusFract;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Sample the pattern at this space"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const rgb = samplePattern(normX, normY, absoluteStripAngle, ledRadiusFract);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Apply device brightness multiplier"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const brightnessMul = config.brightness / 255;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const r = Math.floor(rgb.r * brightnessMul);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const g = Math.floor(rgb.g * brightnessMul);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const b = Math.floor(rgb.b * brightnessMul);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Skip rendering black LEDs entirely to optimize drawing performance"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              if (r < 5 && g < 5 && b < 5) continue;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Compute glow properties for physical visual rendering"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // In rotating systems, outer LEDs travel significantly faster and appear slightly blurred"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const physicalVelocityFactor = ledRadiusFract * (rpm / 1200);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const size = isPlaying && rpm > 100 "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ? 1.2 + physicalVelocityFactor * 1.5 // Outer LEDs draw wider radial arcs (smears slightly)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                : 2.5; // Large crisp dots when stopped"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const pulseCoeff = Math.abs(Math.sin(pulseFreq + i * 0.1));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const intensityGlow = config.showLeds ? 1.0 : (0.55 + pulseCoeff * 0.15);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              if (isPlaying && rpm > 100) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // Highly realistic continuous arc sweep"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.beginPath();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const subStepAngleSize = angleThisFrame / numSubsteps;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // Add a tiny overlap of 0.005 radians to ensure smooth rendering boundaries without micro-gaps"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const startA = absoluteStripAngle - subStepAngleSize - 0.005;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const endA = absoluteStripAngle + 0.005;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.arc(centerX, centerY, ledRadius, startA, endA, false);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${intensityGlow})`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.lineWidth = size;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.lineCap = \'round\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.stroke();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // Draw physical LED pixel dot when stopped or at standby"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.beginPath();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.arc(ledX, ledY, size, 0, Math.PI * 2);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${intensityGlow})`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.fill();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              // Add subtle specular highlights on top of LEDs for highly realistic high-density feel"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              if (config.showLeds && (!isPlaying || rpm < 400)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                ctx.fillStyle = \'rgba(255, 255, 255, 0.4)\';"
