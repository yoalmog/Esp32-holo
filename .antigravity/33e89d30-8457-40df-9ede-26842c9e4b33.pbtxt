          text: " * - CORE 1 Dedicated Interrupter: Ultra-high speed angular timing calculations"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: " *   and synchronous DMA fast LED writes based on Hall sensor cycle times."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: " * - CORE 0 Network Manager: Asynchronous WebServer, WebSocket telemetry endpoint, "
