        }
        lines {
          text: "            <div className=\"bg-[#15171A] p-4 rounded-none border border-[#2A2D33] space-y-4 font-mono text-xs animate-fade-in relative flex flex-col justify-between\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
