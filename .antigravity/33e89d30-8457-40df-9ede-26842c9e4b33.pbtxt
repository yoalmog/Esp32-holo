        lines {
          text: "  const radiusMeters = radiusCm / 100;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const velocityMps = omega * radiusMeters;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const velocityKmh = velocityMps * 3.6;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const velocityMph = velocityKmh * 0.621371;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Centrifugal Acceleration: a_c = \\omega^2 * r"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const accMps2 = Math.pow(omega, 2) * radiusMeters;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const gForce = accMps2 / 9.80665; // Divided by standard gravity G"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Force pulling the critical outermost LED package outward"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const massKg = ledMassMg / 1000000;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const forceNewtons = massKg * accMps2;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const forceGramsEquivalent = forceNewtons * 101.97; // 1 Newton ~ 102 grams of pull force"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // FastLED/DMA timing check"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Standard WS2812B takes exactly 1.25 microseconds per bit, or 30 microseconds per 24-bit pixel."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Plus reset duration (typically 280us-300us)."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Total write duration to update 45 LEDs: (45 * 30us) + 300us = 1650 microseconds!"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Wait! Under serial routing, 45 LEDs of WS2812B takes 1.65ms to write!"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // If sector duration is less than 1.65ms (at high RPMs or slices), the display will overlap and tear!"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // This is a REAL physical limitation of standard WS2812B serial protocols!"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const singleStripRefreshUs = (45 * 30) + 300; // 1650 microseconds for serial WS2812"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // But wait, our ESP32-S3 uses parallel DMA write!"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // It writes all arms simultaneously, so we divide the total led count by parallel outputs!"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Since we run Arm 1 and Arm 2 on dedicated parallel lines, write time is governed by max LEDs per single pin: 45 LEDs."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Parallel DMA write bypasses serial lag, taking exactly the single strip write time: 1.65ms."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const isSerialFeasible = sectorDurationUs > singleStripRefreshUs;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col h-full justify-between\" id=\"math-physics-engine\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
