        lines {
          text: "          <h4 className=\"font-mono text-[10px] uppercase text-[#FFB800] tracking-wider border-l-2 border-[#FFB800] pl-2 font-bold flex items-center gap-1.5 pb-2 border-b border-[#2A2D33]\">"
