        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          if (Math.abs(rFract - 0.6) < 0.015 || Math.abs(rFract - 0.9) < 0.015) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            return { r: 0, g: 180, b: 255 }; // Light blue borders"
