          text: "      quantity: 1,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      unitPrice: 6.30,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      purpose: \'Converts unregulated 12V slip-ring voltage down to robust, Ripple-Free 5V logic power.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      kicadDesignator: \'U3\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      criticalMetric: \'Synchronous Rectification (>94% efficiency)\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Power Calculations"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const singleLedMaxCurrentAmps = 0.055; // 55mA maximum per RGB LED at 100% white"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const espMaxCurrentAmps = 0.25; // ESP32 in AP mode uses ~250mA"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const absolutePeakPowerDrawAmps = parseFloat(((ledCount * singleLedMaxCurrentAmps) + espMaxCurrentAmps).toFixed(2));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const absolutePeakPowerWatts = parseFloat((absolutePeakPowerDrawAmps * 5).toFixed(1));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Dynamic scaled power draw based on actual brightness limit"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const activeBrightnessFactor = maxBrightness / 255;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const averageDrawAmps = parseFloat(((ledCount * singleLedMaxCurrentAmps * activeBrightnessFactor * 0.75) + espMaxCurrentAmps).toFixed(2)); // 0.75 scaling because regular images aren\'t absolute 100% white pixels everywhere"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const averageDrawWatts = parseFloat((averageDrawAmps * 5).toFixed(1));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Slip Ring overcurrent check"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const isSlipRingOverloaded = powerSource === \'slip-ring\' && averageDrawAmps > slipRingRating;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Recommended battery capacity (Rotor mounted LiPo battery)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const recommendedBatteryMah = Math.ceil((averageDrawAmps * 1.5) * 1000); // 1.5 hours operating backup buffer"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col h-full justify-between\" id=\"hardware-bom-panel\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
