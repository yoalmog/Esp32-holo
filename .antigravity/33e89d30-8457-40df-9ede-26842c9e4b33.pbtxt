        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    animationId = requestAnimationFrame(render);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
