t\"\n          ref={canvasRef}\n          width={400}\n          height={400}\n          className=\"w-[340px] h-[340px] md:w-[360px] md:h-[360px] rounded-full shadow-2xl relative z-10 select-none bg-slate-950\"\n        />\n\n        {/* Dynamic Telemetry HUD */}\n        <div className=\"absolute bottom-4 left-4 right-4 z-20 flex justify-between pointer-events-none\">\n          <div className=\"font-mono text-[10px] text-slate-500 flex flex-col bg-slate-950/80 p-2 rounded border border-slate-800\">\n            <span>R-COORDINATE: 0..44</span>\n            <span>THETA-DIV: 60 SLICES</span>\n            <span>I2S DMA BUS: ACTIVE</span>\n          </div>\n          <div className=\"font-mono text-[10px] text-slate-500 flex flex-col bg-slate-950/80 p-2 rounded border border-slate-800 items-end\">\n            <span>RPM STATUS: {config.rpm > 100 ? \'ROTATING\' : \'LOCKED\'}</span>\n            <span>RADIAL VEL: {config.rpm > 0 ? ((config.rpm * 2 * Math.PI) / 60).toFixed(1) : \'0.0\'} rad/s</span>\n            <span>STAGGER: STAGGERED (3x)</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Control Panel Area */}\n      <div className=\"mt-5 space-y-4\">\n        {/* Speed Adjustment Slider */}\n        <div>\n          <div className=\"flex justify-between items-center mb-1\">\n            <span className=\"text-xs font-semibold text-slate-300\">Rotational Speed (RPM)</span>\n            <span className=\"font-mono text-xs font-medium text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/10\">\n              {config.rpm} RPM {config.rpm === 0 ? \'(Stalled)\' : `(${(config.rpm / 60).toFixed(1)} Hz)`}\n            </span>\n          </div>\n          <input\n            id=\"rpm-range-slider\"\n            type=\"range\"\n            min={0}\n            max={1800}\n            step={50}\n            value={config.rpm}\n            onChange={handleRpmSliderChange}\n            className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-500\"\n          />\n          <div className=\"flex justify-between font-mono text-[9px] text-slate-500 mt-1\">\n            <span>0 RPM</span>\n            <span>600 (Flashing/Flicker)</span>\n            <span>1200 (Stable Video)</span>\n            <span>1800 (Ultra POV HD)</span>\n          </div>\n        </div>\n\n        {/* Retinal Fade / Motion Blur Retention */}\n        <div>\n          <div className=\"flex justify-between items-center mb-1\">\n            <span className=\"text-xs font-semibold text-slate-300\">Retinal Decay Time (Motion Blur)</span>\n            <span className=\"font-mono text-xs text-indigo-400\">{(config.motionBlur * 100).toFixed(0)}%</span>\n          </div>\n          <input\n            id=\"blur-range-slider\"\n            type=\"range\"\n            min={0.05}\n            max={0.99}\n            step={0.02}\n            value={config.motionBlur}\n            onChange={handleBlurSliderChange}\n            className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-indigo-500\"\n          />\n          <div className=\"flex justify-between font-mono text-[9px] text-slate-500 mt-1\">\n            <span>Flash Mode (Instant)</span>\n            <span>Balanced Decay</span>\n            <span>Persistent (High Retinal Blur)</span>\n          </div>\n        </div>\n\n        {/* Playback controls & File dropper */}\n        <div className=\"grid grid-cols-2 gap-3 pt-2\">\n          <div className=\"flex gap-2\">\n            <button\n              id=\"playback-toggle-btn\"\n              onClick={togglePlayback}\n              className={`flex-1 flex items-center justify-center gap-2 py-2 px-3 rounded-lg font-mono text-xs font-medium transition border ${\n                isPlaying\n                  ? \'bg-amber-500/10 text-amber-400 border-amber-500/20 hover:bg-amber-500/20\'\n                  : \'bg-emerald-500/10 text-emerald-400 border-emerald-500/20 hover: