          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <stop offset=\"100%\" stopColor=\"#FF4E00\" stopOpacity=\"0\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    </linearGradient>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
