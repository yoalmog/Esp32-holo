          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <div className=\"absolute bottom-1.5 left-2 font-mono text-[8px] text-[#8E9299] select-none pointer-events-none uppercase\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  TRIG: AH3503 INT"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
