        }
        lines {
          text: "    void renderSector(uint16_t sectorIndex) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Arm 1 draws the selected slice direct from FLASH to save Heap memory"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Arm 2 draws the 180-degree offset slice (which is index sectorIndex + (POV_SLICES/2) % POV_SLICES)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        uint16_t sectorArm1 = sectorIndex;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        uint16_t sectorArm2 = (sectorIndex + (POV_SLICES / 2)) % POV_SLICES;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        for (int i = 0; i < numLeds; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Read binary colors from Flash Memory to prevents cache thrashing"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            uint8_t r1 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm1][i][0]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            uint8_t g1 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm1][i][1]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            uint8_t b1 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm1][i][2]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            uint8_t r2 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm2][i][0]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            uint8_t g2 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm2][i][1]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            uint8_t b2 = pgm_read_byte(&POLAR_IMAGE_DATA[sectorArm2][i][2]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Hardware thermal/current optimization check"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // High current density can cause the contacts of standard PCB slip-rings to weld."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // Brightness limiter keeps total sector energy draw low."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            ledsArm1[i] = CRGB(r1, g1, b1);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            ledsArm2[i] = CRGB(r2, g2, b2);"
