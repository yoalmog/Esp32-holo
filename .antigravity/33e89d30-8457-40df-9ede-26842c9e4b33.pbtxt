        }
        lines {
          text: "          </h4>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <p className=\"text-[11px] text-[#8E9299] leading-relaxed font-mono uppercase\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            The unipolar hall sensor provides the physical 0\302\260 trigger datum. Any angular misalignment causes projected hologram geometries to appear visually rotated or upside-down."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
